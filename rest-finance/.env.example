# Copiez ce fichier en ".env" (jamais commité) et renseignez votre clé.
# Clé Google AI Studio pour Gemini : https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Base PostgreSQL (recommandée). Sans POSTGRES_DB, Django utilise SQLite (db.sqlite3).
# POSTGRES_DB=mefa
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=motdepasse
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Réglages Django pour la mise en ligne (laisser vide en développement).
# DJANGO_SECRET_KEY=une-longue-cle-aleatoire
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=api.mondomaine.com
